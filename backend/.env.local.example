# Copy to backend/.env.local (git-ignored) and fill in your key.
# Values here override backend/.env.

# Local SQLite database (paths are relative to the backend/ folder)
DATABASE_URL="sqlite+aiosqlite:///./storage/talkwiseai.db"
DATABASE_SYNC_URL="sqlite:///./storage/talkwiseai.db"

# Groq (free key: https://console.groq.com/keys) via the OpenAI-compatible API
LLM_PROVIDER="openai"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
LLM_REASONING_EFFORT="low"
LLM_API_KEY="gsk_your_groq_key_here"
LLM_MAX_TOKENS=2048
LLM_MAX_CONCURRENCY=3

# Speech-to-text through Groq's hosted Whisper (uses LLM_API_KEY / LLM_BASE_URL)
STT_PROVIDER="whisper_api"
STT_API_MODEL="whisper-large-v3-turbo"
STT_MAX_UPLOAD_MB=25

# Semantic search: local ONNX embeddings stored in ChromaDB (no key needed)
EMBEDDING_PROVIDER="local"
