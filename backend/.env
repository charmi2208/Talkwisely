# =============================================================================
# TalkWiseAI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME="TalkWiseAI"
APP_ENV="development"           # development | production
APP_DEBUG=true
APP_SECRET_KEY="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
APP_HOST="0.0.0.0"
APP_PORT=8000
FRONTEND_URL="http://localhost:3000"

# --- Database ---
DATABASE_URL="sqlite+aiosqlite:///C:/Users/charmi/AppData/Local/Temp/talkwiseai.db"
DATABASE_SYNC_URL="sqlite:///C:/Users/charmi/AppData/Local/Temp/talkwiseai.db"

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# --- JWT ---
JWT_SECRET_KEY="CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider ---
# Options: openai | mock
LLM_PROVIDER="mock"
LLM_API_KEY="sk-your-openai-key-here"
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_BASE_URL=""   # For OpenAI-compatible APIs (e.g. Together AI, Groq). Leave blank for OpenAI.

# --- Embedding Provider ---
# Options: openai | sentence_transformers | mock
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# --- Speech-to-Text Provider ---
# Options: whisper_local | whisper_api | mock
STT_PROVIDER="mock"
WHISPER_MODEL="base"  # tiny | base | small | medium | large

# --- File Storage ---
# Options: local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
STORAGE_MAX_UPLOAD_SIZE_MB=500
STORAGE_ALLOWED_AUDIO_EXTENSIONS=".mp3,.wav,.m4a,.ogg,.flac"
STORAGE_ALLOWED_VIDEO_EXTENSIONS=".mp4,.avi,.mov,.mkv,.webm"

# AWS S3 (only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# --- Vector Database ---
VECTOR_DB_PROVIDER="chromadb"
CHROMA_PERSIST_DIR="./vector_store"

# --- CRM Integration ---
# Options: mock | hubspot | salesforce | zoho
CRM_PROVIDER="mock"
HUBSPOT_API_KEY=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""

# --- Calendar Integration ---
# Options: mock | google | outlook
CALENDAR_PROVIDER="mock"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email Integration ---
# Options: mock | sendgrid | smtp
EMAIL_PROVIDER="mock"
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@talkwiseai.com"

# --- TalkWisely Integration ---
# Options: mock | talkwisely
TALKWISELY_PROVIDER="mock"
TALKWISELY_API_BASE_URL=""
TALKWISELY_API_KEY=""
TALKWISELY_ACCOUNT_ID=""

# --- Logging ---
LOG_LEVEL="INFO"
LOG_FORMAT="json"   # json | text

# --- CORS ---
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# --- Demo Mode ---
DEMO_MODE_ENABLED=true
DEMO_ORG_SLUG="demo"
